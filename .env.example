# Metafyx AI Backend Configuration
#
# API keys are OPTIONAL here. Each user can enter their own key in the
# extension popup (Settings -> Your API key); that key is used for their
# requests. A key set below is only the fallback for users who have none.

# Default AI provider: 'gemini', 'openai' or 'grok'
AI_PROVIDER=gemini

# Optional fallback keys (leave empty to require every user to bring a key)
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# xAI:    https://console.x.ai
GROK_API_KEY=

# Optional model overrides. Defaults: gemini-flash-latest, gpt-4o, grok-2-vision-1212
# (gemini-2.0-flash was retired by Google on 2026-06-01 and no longer works)
#GEMINI_MODEL=gemini-flash-latest
#OPENAI_MODEL=gpt-4o
#GROK_MODEL=grok-2-vision-1212

# Keywords generated per image (5-49)
#KEYWORD_COUNT=10

# Server port and bind address (127.0.0.1 = this computer only)
PORT=3000
#HOST=127.0.0.1

# Node environment
NODE_ENV=production
