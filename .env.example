# Metafyx AI Backend Configuration

# AI Provider: 'openai' or 'gemini'
AI_PROVIDER=gemini

# API Key for chosen provider
# For OpenAI: Get from https://platform.openai.com/api-keys
# For Gemini: Get from https://aistudio.google.com/apikey
API_KEY=
# Server port
PORT=3000

# Node environment
NODE_ENV=production
